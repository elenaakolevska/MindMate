FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install minimal requirements first
COPY requirements.minimal.txt /app/
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.minimal.txt

# Copy project
COPY . /app

EXPOSE 8000

# Simple entrypoint inline
CMD python manage.py migrate --noinput && \
    python manage.py collectstatic --noinput || true && \
    gunicorn MindMate.wsgi:application --bind 0.0.0.0:8000

